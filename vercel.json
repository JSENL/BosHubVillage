{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build:serverless-ssr",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/sitemap\\.xml", "dest": "/api/sitemap" },
    { "src": "/robots\\.txt", "dest": "/robots.txt" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api/ssr" }
  ]
}
